# ==============================================================================
# SMART CAMPUS 360 - ENVIRONMENT VARIABLES (.env.example)
# College: Government Engineering College, Mosalehosahalli (Hassan), Karnataka
# ==============================================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-campus-360-gec-hassan-secret-key-change-in-production-2026

# Database Configuration
# Set USE_SQLITE=True for instant testing without configuring MySQL.
# Set USE_SQLITE=False to connect to your local or remote MySQL Server.
USE_SQLITE=False
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=smart_campus_360

# File Upload Settings
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216

# Campus Information (Fixed institutional parameters)
COLLEGE_NAME="Government Engineering College, Mosalehosahalli"
COLLEGE_LOCATION="Hassan, Karnataka, India"
APP_NAME="Smart Campus 360"

# ==============================================================================
# PHASE 5 - Lost & Found AI matcher thresholds (all optional, defaults shown).
# Tune ONLY after measuring with:  python evaluate_matcher.py  (see evaluation/)
# ==============================================================================
# LF_MATCH_MIN_COMPOSITE=0.35   # below this, no suggestion is surfaced
# LF_STRONG_MATCH_SCORE=0.70    # 'high' confidence band boundary
# LF_MEDIUM_MATCH_SCORE=0.50    # 'medium' confidence band boundary
# LF_DUPLICATE_SCORE=0.65       # duplicate-report detection cut-off
# LF_MATCH_LIMIT=10             # ranked suggestions stored per report

# ==============================================================================
# PHASE 6 - Smart Canteen booking / teacher-first allocation (optional, defaults shown).
# ==============================================================================
# CANTEEN_TEACHER_PRIORITY_ENABLED=True   # master switch for teacher seat reservation
# CANTEEN_TEACHER_RESERVE_RATIO=0.25      # share of each slot held for verified teachers
# CANTEEN_AUTO_CONFIRM=True               # confirm orders automatically when seats exist
# CANTEEN_MIN_LEAD_MINS=15                # booking lead time before a slot starts
# CANTEEN_PREP_MIN_PER_ORDER=4            # minutes added per order queued ahead

# ==============================================================================
# PHASE 7 - Payment & refund processing (sandbox by default; Stripe TEST MODE only).
# ==============================================================================
# PAYMENT_PROVIDER=sandbox                # 'sandbox' (no credentials) or 'stripe'
# PAYMENT_CURRENCY=inr
# Sandbox behaviour switches used by demo/testing (NEVER real money movement):
#   PAYMENT_SANDBOX_PAYMENT_OUTCOME=succeeded   # succeeded | failed | processing
#   PAYMENT_SANDBOX_REFUND_OUTCOME=succeeded    # succeeded | failed | processing
# PAYMENT_AUTO_REFUND_ON_UNFULFILLABLE=True
# PAYMENT_WEBHOOK_TOLERANCE_SECS=300

# --- Stripe TEST MODE credentials (optional) ----------------------------------
# The integration REFUSES any key that is not a test-mode key (sk_test_/rk_test_).
# NEVER put a live key here and NEVER expose secret keys to the frontend.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret: for sandbox this is any shared HMAC secret; for Stripe
# use the whsec_... shown by `stripe listen` / the dashboard endpoint.
# PAYMENT_WEBHOOK_SECRET=change-me-sandbox-webhook-secret

# ==============================================================================
# DOCKER (Phase 2+) - used by compose.yaml for variable interpolation.
# Copy this file to .env and fill in real values. NEVER commit .env.
# ==============================================================================

# Host port the containerized app is published on (5000 stays free for local run.py)
WEB_PORT=8080

# Docker database mode: True = reuse existing SQLite from ./instance (default,
# zero-migration). Set False only when running the optional MySQL profile:
#   docker compose --profile mysql up -d
DOCKER_USE_SQLITE=True

# Internal Docker service name/port of the database (used when DOCKER_USE_SQLITE=False)
DOCKER_DB_HOST=db
DOCKER_DB_PORT=3306

# MySQL root password for the Docker 'db' service is taken from DB_PASSWORD
# above. Do NOT put a real secret in this example file.

# ==============================================================================
# SMART CAMPUS 360 - ENVIRONMENT VARIABLES (.env.example)
# College: Government Engineering College, Mosalehosahalli (Hassan), Karnataka
# ==============================================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-campus-360-gec-hassan-secret-key-change-in-production-2026

# Database Configuration
# Set USE_SQLITE=True for instant testing without configuring MySQL.
# Set USE_SQLITE=False to connect to your local or remote MySQL Server.
USE_SQLITE=False
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=smart_campus_360

# File Upload Settings
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216

# Campus Information (Fixed institutional parameters)
COLLEGE_NAME="Government Engineering College, Mosalehosahalli"
COLLEGE_LOCATION="Hassan, Karnataka, India"
APP_NAME="Smart Campus 360"

# ==============================================================================
# DOCKER (Phase 2+) - used by compose.yaml for variable interpolation.
# Copy this file to .env and fill in real values. NEVER commit .env.
# ==============================================================================

# Host port the containerized app is published on (5000 stays free for local run.py)
WEB_PORT=8080

# Docker database mode: True = reuse existing SQLite from ./instance (default,
# zero-migration). Set False only when running the optional MySQL profile:
#   docker compose --profile mysql up -d
DOCKER_USE_SQLITE=True

# Internal Docker service name/port of the database (used when DOCKER_USE_SQLITE=False)
DOCKER_DB_HOST=db
DOCKER_DB_PORT=3306

# MySQL root password for the Docker 'db' service is taken from DB_PASSWORD
# above. Do NOT put a real secret in this example file.
